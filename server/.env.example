# Stripe Settings
# You can find these in your Stripe Dashboard (Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# MongoDB Settings
# Get this from MongoDB Atlas (Connect -> Connect your application)
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/cata?retryWrites=true&w=majority

# Server Settings
PORT=5001
